<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Server-side only. The Godot client deliberately keeps its own DTOs and
         talks to this service over HTTP, so nothing here needs to be consumable
         by the client's target framework. -->
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
